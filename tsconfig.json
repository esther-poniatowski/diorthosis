// =================================================================================================
// TypeScript Configuration for Diorthosis
//
// Kept at the repository root (rather than in `config/tools/`) because editors, ESLint's type-aware
// rules and `tsc` resolve it from the root by default. Type checking only: emission is delegated to
// esbuild (see `config/tools/esbuild.config.mjs`).
//
// No JSX setting is declared until the interface framework is decided. That decision must set the
// JSX options here, since esbuild and Vitest read them from this file.
// =================================================================================================
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "config/tools/*.ts"]
}
