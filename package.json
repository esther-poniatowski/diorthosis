{
  "name": "diorthosis",
  "version": "0.0.0",
  "private": true,
  "description": "Reviews notes and YAML records in Obsidian through threaded review items stored apart from the reviewed files.",
  "author": "Esther Poniatowski",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node config/tools/esbuild.config.mjs",
    "build": "tsc --noEmit && node config/tools/esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config config/tools/eslint.config.mjs --no-error-on-unmatched-pattern src tests",
    "format": "prettier --config config/tools/prettier.json --no-error-on-unmatched-pattern --write src tests",
    "format:check": "prettier --config config/tools/prettier.json --no-error-on-unmatched-pattern --check src tests",
    "test": "vitest run --config config/tools/vitest.config.ts",
    "test:watch": "vitest --config config/tools/vitest.config.ts",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "obsidian": "latest",
    "prettier": "^3.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
